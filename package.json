{
  "name": "gpcl",
  "version": "1.9.3",
  "description": "Minecraft 启动器",
  "main": "main.js",
  "scripts": {
    "build-ts": "node build.js",
    "start": "chcp 65001 >nul && npm run build-ts && electron dist/",
    "start:dev": "chcp 65001 >nul && npm run build-ts && electron dist/",
    "start:linux": "npm run build-ts && electron dist/",
    "pack": "npm run build-ts && electron-builder --win --dir --publish=never",
    "pack:linux": "npm run build-ts && electron-builder --linux --dir --publish=never",
    "build-linux": "npm run build-ts && electron-builder --linux --publish=never",
    "installer": "node scripts/build-installer.mjs",
    "build-prod": "npm run pack && node scripts/build-installer.mjs",
    "dist:nsis": "npm run build-ts && electron-builder --publish=never",
    "typecheck": "tsc --noEmit",
    "clean": "if (Test-Path dist) { Remove-Item -Recurse -Force dist }",
    "clean:linux": "rm -rf dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "CaelLab",
  "license": "SEE LICENSE IN LICENSE",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "unzip-stream": "^0.3.4"
  },
  "build": {
    "appId": "com.caellab.gamets.gpcl",
    "productName": "GoodPlanCraftLauncher",
    "icon": "icon.ico",
    "directories": {
      "app": "dist",
      "output": "release"
    },
    "asar": true,
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "icon": "static/icon/GPCL.png",
      "artifactName": "GPCL-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "installerHeaderIcon": "icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GoodPlanCraftLauncher",
      "artifactName": "GPCL-${version}-Setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "**/*",
      "!.minecraft/**",
      "!win-unpacked/**"
    ],
    "asarUnpack": [
      "node_modules/adm-zip/**/*",
      "node_modules/unzip-stream/**/*"
    ]
  }
}
